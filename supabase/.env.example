# Linkr Edge runtime configuration. Populate through Supabase secrets or a secret manager.
# Never commit a populated supabase/.env.local file.

# Core Supabase runtime
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_ANON_KEY=

# Internal trust boundaries and encryption (use separate high-entropy values)
LINKR_INTERNAL_KEY=replace_with_32_plus_random_bytes
X_INTERNAL_CRON_KEY=replace_with_32_plus_random_bytes
WALLET_ENCRYPTION_SECRET=replace_with_32_plus_random_bytes
X_TOKEN_ENCRYPTION_SECRET=replace_with_32_plus_random_bytes
X_OAUTH_ADMIN_KEY=replace_with_32_plus_random_bytes
AGENT_API_KEY_PEPPER=replace_with_32_plus_random_bytes
AGENT_API_KEY_PEPPER_V2=replace_with_new_32_plus_random_bytes
WALLET_EXPORT_DISABLED=false

# Model provider and long-running execution
COMET_API_KEY=replace_me
COMET_TIMEOUT_MS=120000
COMET_STREAM_TIMEOUT_MS=120000
COMET_ATTEMPTS_PER_MODEL=2
COMET_HOTPATH_TIMEOUT_MS=45000
COMET_HOTPATH_ATTEMPTS=1
LINKR_ACTION_EXECUTOR_TIMEOUT_MS=240000
LINKR_IMAGE_MODEL=replace_me

# X / Twitter
X_CLIENT_ID=replace_me
X_CLIENT_SECRET=replace_me
X_BEARER_TOKEN=replace_me
TWITTER_BEARER_TOKEN=
X_BOT_USERNAME=linkrbot
X_OAUTH1_CONSUMER_KEY=replace_me
X_OAUTH1_CONSUMER_SECRET=replace_me
X_OAUTH1_ACCESS_TOKEN=replace_me
X_OAUTH1_ACCESS_TOKEN_SECRET=replace_me
X_LAUNCH_MIN_BALANCE_SOL=0
X_LAUNCH_MIN_BALANCE_ETH=0

# Telegram
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_BOT_USERNAME=replace_me
TELEGRAM_WEBHOOK_SECRET=replace_with_32_plus_random_bytes

# Solana and trading providers
SOLANA_RPC_URL=https://replace-me.example
QUICKNODE_SOLANA_RPC_URL=
HELIUS_RPC_URL=
HELIUS_API_KEY=
HELIUS_SENDER_URL=
HELIUS_SENDER_ENDPOINT=
JUPITER_API_KEY=
JUPITER_QUOTE_URL=https://quote-api.jup.ag/v6/quote
JUPITER_SWAP_URL=https://quote-api.jup.ag/v6/swap
SOL_FUNDING_WALLET=
PUMP_FUN_LAUNCH_COMPUTE_UNITS=400000
PUMP_FUN_LAUNCH_PRIORITY_MICROLAMPORTS=0
PUMP_FUN_REWARDS_COMPUTE_UNITS=400000
PUMP_FUN_REWARDS_PRIORITY_MICROLAMPORTS=0
PUMP_FUN_REWARD_RECIPIENT_INIT_LAMPORTS=0
PUMP_SWAP_PRIORITY_MICROLAMPORTS=0

# Robinhood Chain / EVM
RH_RPC_URL=https://replace-me.example
RH_ARCHIVE_RPC_URL=
ROBINHOOD_RPC_URL=https://replace-me.example
ROBINHOOD_FORK_BLOCK=
ROBINHOOD_LAUNCH_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
ROBINHOOD_LAUNCH_LOCKER_ADDRESS=0x0000000000000000000000000000000000000000
ROBINHOOD_SWAP_ROUTER_ADDRESS=0x0000000000000000000000000000000000000000
ROBINHOOD_V3_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
ROBINHOOD_POSITION_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
ROBINHOOD_V3_POSITION_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
ROBINHOOD_WETH_ADDRESS=0x0000000000000000000000000000000000000000
DEPLOYER_PRIVATE_KEY=
MAX_INITIAL_BUY_ETH=0
MAX_FIRST_LAUNCH_SUBSIDY_ETH=0
ROBINHOOD_LIQUIDITY_ENABLED=false
ROBINHOOD_LIQUIDITY_DEFAULT_FEE=3000
ROBINHOOD_LIQUIDITY_DEFAULT_RANGE_WIDTH=0
ROBINHOOD_LIQUIDITY_DEFAULT_RANGE_MULTIPLIER=1
ROBINHOOD_LIQUIDITY_DEADLINE_SECONDS=1200
ROBINHOOD_LIQUIDITY_MAX_ADD_ETH=0
ROBINHOOD_LIQUIDITY_MAX_REMOVE_PERCENT=100
UNISWAP_API_KEY=

# IPFS / Filebase
IPFS_PROVIDER=filebase
IPFS_GATEWAY_URL=https://ipfs.filebase.io/ipfs
FILEBASE_IPFS_BUCKET=replace_me
FILEBASE_S3_ACCESS_KEY_ID=replace_me
FILEBASE_S3_SECRET_ACCESS_KEY=replace_me
FILEBASE_S3_ENDPOINT=https://s3.filebase.com
FILEBASE_S3_REGION=us-east-1

# Market data
MORALIS_API_KEY=
LINKR_MARKET_DATA_ENABLED=true
LINKR_DEXSCREENER_ENABLED=true
LINKR_MORALIS_ENABLED=false
LINKR_MARKET_DATA_CACHE_TTL_SECONDS=30
LINKR_MARKET_DATA_DISCOVERY_TTL_SECONDS=300
LINKR_MARKET_DATA_METADATA_TTL_SECONDS=3600
LINKR_MARKET_DATA_MAX_PROMPT_BYTES=65536
SOLANA_DEXSCREENER_CHAIN_SLUG=solana
ROBINHOOD_DEXSCREENER_CHAIN_SLUG=robinhood
ROBINHOOD_MORALIS_CHAIN_ID=

# Runtime controls and bounded work
LINKR_BROWSER_ORIGINS=https://linkr.cash
LINKR_DEFAULT_LAUNCH_WEBSITE=https://linkr.cash
LINKR_AGENT_API_REQUESTS_PER_MINUTE=60
LINKR_TERMINAL_REQUESTS_PER_MINUTE=30
LINKR_MENTION_DEADLINE_MS=90000
LINKR_MENTION_PASSES=3
LINKR_MENTION_PASS_INTERVAL_MS=2000
LINKR_FAST_HANDOFF_ENABLED=true
LINKR_QUEUE_SHADOW_ENABLED=false
LINKR_RPC_POOL_ENABLED=true
SCHEDULED_ACTION_BATCH_SIZE=25
SCHEDULED_ACTION_MARKET_CHECK_SECONDS=60
SCHEDULED_ACTION_STALE_MINUTES=15
SYSTEM_HEALTH_OK_SAMPLE_MINUTES=5

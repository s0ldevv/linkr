# Local deployment credentials. Do not commit a populated copy.
SUPABASE_PROJECT_REF=replace_me
SUPABASE_ACCESS_TOKEN=replace_me
SUPABASE_DB_PASSWORD=replace_me
SUPABASE_DB_URL=postgresql://postgres:replace_me@db.YOUR_PROJECT.supabase.co:5432/postgres
SUPABASE_CLI_TELEMETRY_DISABLED=1

# Optional local server deployment credential. Keep outside browser/VITE variables.
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_SECRET_KEY=replace_me

# Created by Vercel CLI when using OIDC. Do not copy between environments.
VERCEL_OIDC_TOKEN=replace_me

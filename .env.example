# Browser-safe values. Only VITE_* variables are bundled into the client.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Optional legacy compatibility when the project still uses anon JWT keys.
VITE_SUPABASE_ANON_KEY=
VITE_IPFS_GATEWAY_URL=https://ipfs.filebase.io/ipfs
VITE_ROBINHOOD_DEXSCREENER_CHAIN_SLUG=robinhood

# Server-side TanStack/Nitro gateway values. Never expose the service-role key to Vite.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_ANON_KEY=
# Prefer the publishable key. Set service role only in a trusted server runtime when required.
SUPABASE_SERVICE_ROLE_KEY=
LINKR_GATEWAY_CONNECT_TIMEOUT_MS=30000
LINKR_GATEWAY_STREAM_IDLE_TIMEOUT_MS=45000
LINKR_GATEWAY_RESPONSE_IDLE_TIMEOUT_MS=30000

APP_ORIGIN=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
LINKR_APP_URL=http://localhost:3000

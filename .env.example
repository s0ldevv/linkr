# Browser-safe values. Only VITE_* variables are bundled into the client.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Optional legacy compatibility when the project still uses anon JWT keys.
VITE_SUPABASE_ANON_KEY=
VITE_IPFS_GATEWAY_URL=https://ipfs.filebase.io/ipfs
VITE_ROBINHOOD_DEXSCREENER_CHAIN_SLUG=robinhood

# Server-side TanStack/Nitro gateway values. Never expose the service-role key to Vite.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_ANON_KEY=
# Prefer the publishable key. Set service role only in a trusted server runtime when required.
SUPABASE_SERVICE_ROLE_KEY=
LINKR_GATEWAY_CONNECT_TIMEOUT_MS=30000
LINKR_GATEWAY_STREAM_IDLE_TIMEOUT_MS=45000
LINKR_GATEWAY_RESPONSE_IDLE_TIMEOUT_MS=30000

APP_ORIGIN=https://linkr.cash
PUBLIC_SITE_URL=https://linkr.cash
LINKR_APP_URL=https://linkr.cash

# Twilio SMS values are server-only. Set real values as Supabase Edge secrets.
TWILIO_ACCOUNT_SID=AC_REPLACE_ME
TWILIO_AUTH_TOKEN=replace_me
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=MG_REPLACE_ME
TWILIO_WEBHOOK_PUBLIC_URL=https://YOUR_PROJECT.supabase.co/functions/v1/sms-webhook
TWILIO_STATUS_CALLBACK_PUBLIC_URL=https://YOUR_PROJECT.supabase.co/functions/v1/sms-status-callback
LINKR_PHONE_HASH_PEPPER=replace_with_32_plus_random_bytes
LINKR_SMS_REQUESTS_PER_MINUTE=10
LINKR_SMS_LOGIN_TOKEN_TTL_SECONDS=600
LINKR_SMS_MAX_REPLY_CHARS=1500
